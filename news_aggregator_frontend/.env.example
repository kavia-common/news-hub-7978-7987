# Site URL (for social links, etc.)
REACT_APP_SITE_URL=http://localhost:3000

# If using backend aggregation instead of direct GNews calls later:
REACT_APP_API_BASE_URL=http://localhost:4000/api

# GNews defaults (already set in code; can override if desired)
REACT_APP_GNEWS_API_BASE_URL=https://gnews.io/api/v4
REACT_APP_GNEWS_API_KEY=your_gnews_api_key
