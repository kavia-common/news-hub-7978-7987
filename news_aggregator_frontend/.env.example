# Environment example for the News Aggregator frontend
# Copy this file to `.env` and fill in the values before running locally.
# IMPORTANT: Do NOT commit real keys to source control.

# NewsAPI.org API key (required for fetching news)
REACT_APP_NEWS_API_KEY=your_newsapi_key_here

# Base URL for NewsAPI (can be left as default)
REACT_APP_NEWS_API_BASE_URL=https://newsapi.org/v2

# Optional: Site URL for social sharing (used in metadata)
REACT_APP_SITE_URL=http://localhost:3000
